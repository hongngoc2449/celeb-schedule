# 1. MongoDB Atlas Connection (Free M0 Tier)
# Đăng ký miễn phí tại https://www.mongodb.com/cloud/atlas
# Nếu để trống, hệ thống sẽ tự động dùng local JSON storage (data-store.json)
MONGODB_URI=
MONGODB_DB=osad_celebrity

# 2. Admin Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=osad2026
ADMIN_JWT_SECRET=osad-chutich-mai-secret-token-key-2026

# 3. Cloudinary Image Storage (Free Tier 25GB)
# Đăng ký miễn phí tại https://cloudinary.com
# Nếu để trống, ảnh upload sẽ tự động lưu vào thư mục public/uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

